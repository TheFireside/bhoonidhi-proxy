{
  "name": "bhoonidhi-proxy",
  "version": "1.0.0",
  "description": "This project provides a drop-in replacement for the Bhoonidhi Satellite Data API. It is useful when the original Bhoonidhi service is down, but your application depends on its REST API format.",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --exec ts-node src/lambdaHandler.ts",
    "build": "tsc",
    "start": "node dist/lambdaHandler.js",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.10.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "serverless-http": "^3.2.0"
  },
  "lint-staged": {
    "src/*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.13",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "nodemon": "^3.1.10",
    "prettier": "3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  }
}
