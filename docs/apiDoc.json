{
  "openapi": "3.0.0",
  "info": {
    "title": "Bhoonidhi API",
    "version": "1.0.0",
    "description": "API specification for accessing Bhoonidhi Earth Observation Satellite Data Platform."
  },
  "servers": [
    { "url": "https://bhoonidhi-proxy.onrender.com" }
  ],
  "paths": {
    "/auth/token": {
      "post": {
        "summary": "Obtain Access or Refresh Token",
        "description": "Authenticate user and receive access token for API usage.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "userId": { "type": "string" },
                      "password": { "type": "string" },
                      "grant_type": { "type": "string", "enum": ["password"] }
                    },
                    "required": ["userId", "password", "grant_type"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "userId": { "type": "string" },
                      "refresh_token": { "type": "string" },
                      "grant_type": { "type": "string", "enum": ["refresh_token"] }
                    },
                    "required": ["userId", "refresh_token", "grant_type"]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful token generation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": { "type": "string" },
                    "access_token": { "type": "string" },
                    "token_type": { "type": "string" },
                    "expires_in": { "type": "integer" },
                    "refresh_token": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout and revoke refresh token",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out successfully" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/data/search": {
      "post": {
        "summary": "Search satellite data",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SearchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/download": {
      "get": {
        "summary": "Download data product",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "id", "schema": { "type": "string" }, "required": true },
          { "in": "query", "name": "collection", "schema": { "type": "string" }, "required": true }
        ],
        "responses": {
          "200": { "description": "Download initiated" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Product not found" },
          "412": { "description": "Concurrent downloads exceeded" },
          "500": { "description": "Internal Server Error" },
          "504": { "description": "Gateway Timeout" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SearchRequest": {
        "type": "object",
        "properties": {
          "collections": { "type": "array", "items": { "type": "string" } },
          "datetime": { "type": "string" },
          "filter": { "type": "object" },
          "filter-lang": { "type": "string", "enum": ["cql2-json"] },
          "intersects": { "type": "object" },
          "limit": { "type": "integer" },
          "sortby": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "direction": { "type": "string", "enum": ["asc", "desc"] }
              }
            }
          },
          "fields": {
            "type": "object",
            "properties": {
              "include": { "type": "array", "items": { "type": "string" } },
              "exclude": { "type": "array", "items": { "type": "string" } }
            }
          },
          "token": { "type": "string" },
          "filter-crs": { "type": "string" }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "context": {
            "type": "object",
            "properties": {
              "limit": { "type": "integer" },
              "returned": { "type": "integer" }
            }
          },
          "features": {
            "type": "array",
            "items": { "type": "object" }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rel": { "type": "string" },
                "type": { "type": "string" },
                "href": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
